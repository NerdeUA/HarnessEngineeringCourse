[0.002, "o", "\r\nOfficial Qdrant MCP tools\r\n"]
[0.089, "o", "data: {\"jsonrpc\":\"2.0\",\"id\":90,\"result\":{\"tools\":[{\"name\":\"qdrant-find\",\"description\":\"Search the MiniLM comparison collection for records matching a natural language query. Return the source metadata with each relevant result.\",\"inputSchema\":{\"properties\":{\"query\":{\"description\":\"What to search for\",\"title\":\"Query\",\"type\":\"string\"}},\"required\":[\"query\"],\"type\":\"object\"}},{\"name\":\"qdrant-store\",\"description\":\"Store one course corpus record in the MiniLM comparison collection. Put the searchable prose in information and source, kind, namespace, and object name in metadata.\",\"inputSchema\":{\"properties\":{\"information\":{\"description\":\"Text to store\",\"title\":\"Information\",\"type\":\"string\"},\"metadata\":{\"anyOf\":[{\"additionalProperties\":true,\"type\":\"object\"},{\"type\":\"null\"}],\"default\":null,\"description\":\"Extra metadata stored along with memorised information. Any json is accepted.\",\"title\":\"Metadata\"}},\"required\":[\"information\"],\"type\":\"object\"}}]}}\r\n\r\n"]
[0.001, "o", "\r\nABox baseline MCP tools\r\n"]
[0.051, "o", "data: {\"jsonrpc\":\"2.0\",\"id\":91,\"result\":{\"tools\":[{\"name\":\"chat\",\"description\":\"Generate a chat completion. Requires a llama.cpp server serving a generative model.\",\"inputSchema\":{\"type\":\"object\",\"required\":[\"prompt\"],\"properties\":{\"max_tokens\":{\"type\":\"integer\"},\"prompt\":{\"type\":\"string\"},\"system\":{\"type\":\"string\"},\"temperature\":{\"type\":\"number\"}},\"additionalProperties\":{\"not\":{}}},\"outputSchema\":{\"type\":\"object\",\"required\":[\"body\"],\"properties\":{\"body\":{\"type\":\"string\"}},\"additionalProperties\":{\"not\":{}}}},{\"name\":\"embed\",\"description\":\"Embed text and return the vector. nomic-embed expects a 'search_document: ' or 'search_query: ' prefix on the input.\",\"inputSchema\":{\"type\":\"object\",\"required\":[\"input\"],\"properties\":{\"input\":{\"type\":\"string\"},\"model\":{\"type\":\"string\"}},\"additionalProperties\":{\"not\":{}}},\"outputSchema\":{\"type\":\"object\",\"required\":[\"body\"],\"properties\":{\"body\":{\"type\":\"string\"}},\"additionalProperties\":{\"not\":{}}}},{\"name\":\"embed_health\",\"description\":\"Check whether the embeddings server is up"]
[0.000, "o", " and has finished loading its model.\",\"inputSchema\":{\"type\":\"object\",\"additionalProperties\":{\"not\":{}}},\"outputSchema\":{\"type\":\"object\",\"required\":[\"body\"],\"properties\":{\"body\":{\"type\":\"string\"}},\"additionalProperties\":{\"not\":{}}}},{\"name\":\"embed_models\",\"description\":\"List the models the configured server has loaded.\",\"inputSchema\":{\"type\":\"object\",\"additionalProperties\":{\"not\":{}}},\"outputSchema\":{\"type\":\"object\",\"required\":[\"body\"],\"properties\":{\"body\":{\"type\":\"string\"}},\"additionalProperties\":{\"not\":{}}}},{\"name\":\"llamacpp_props\",\"description\":\"Report the server's build, context size, slot count and the flags it was started with.\",\"inputSchema\":{\"type\":\"object\",\"additionalProperties\":{\"not\":{}}},\"outputSchema\":{\"type\":\"object\",\"required\":[\"body\"],\"properties\":{\"body\":{\"type\":\"string\"}},\"additionalProperties\":{\"not\":{}}}},{\"name\":\"llamacpp_tokenize\",\"description\":\"Tokenize text with the loaded model's tokenizer and return the token ids.\",\"inputSchema\":{\"type\":\"object\",\"required\":[\"content\"],\"properties\":{\""]
[0.000, "o", "content\":{\"type\":\"string\"}},\"additionalProperties\":{\"not\":{}}},\"outputSchema\":{\"type\":\"object\",\"required\":[\"body\"],\"properties\":{\"body\":{\"type\":\"string\"}},\"additionalProperties\":{\"not\":{}}}},{\"name\":\"vector_find\",\"description\":\"Semantic search over what vector_store has remembered.\",\"inputSchema\":{\"type\":\"object\",\"required\":[\"query\"],\"properties\":{\"limit\":{\"type\":\"integer\"},\"query\":{\"type\":\"string\"}},\"additionalProperties\":{\"not\":{}}},\"outputSchema\":{\"type\":\"object\",\"required\":[\"body\"],\"properties\":{\"body\":{\"type\":\"string\"}},\"additionalProperties\":{\"not\":{}}}},{\"name\":\"vector_store\",\"description\":\"Embed text with the configured embeddings server and store it in Qdrant. Long text is split into several points; nothing is dropped.\",\"inputSchema\":{\"type\":\"object\",\"required\":[\"information\"],\"properties\":{\"information\":{\"type\":\"string\"},\"metadata\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"}}},\"additionalProperties\":{\"not\":{}}},\"outputSchema\":{\"type\":\"object\",\"required\":[\"body\"],\"properties\":{\"body\":{\""]
